# Copy this file to .env and replace each value with a unique random secret.
SECRET_KEY=replace-with-a-long-random-secret
PASSWORD_PEPPER=replace-with-a-different-long-random-secret
TOTP_ENCRYPTION_KEY=generate-with-Fernet-generate_key-and-keep-private
BACKUP_ENCRYPTION_KEY=generate-a-different-Fernet-key-and-keep-private
INSTRUCTOR_INVITE_CODE=replace-with-a-random-invite-code
COOKIE_SECURE=0
APP_ENV=development
# Optional; defaults to a local SQLite database in the instance folder.
# DATABASE_URL=sqlite:///plato.db
