{
  "expo": {
    "name": "Secure Workspace",
    "slug": "secure-workspace",
    "scheme": "secureworkspace",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-web-browser"
    ],
    "experiments": { "typedRoutes": true },
    "ios": { "bundleIdentifier": "com.example.secureworkspace" },
    "android": { "package": "com.example.secureworkspace" }
  }
}
